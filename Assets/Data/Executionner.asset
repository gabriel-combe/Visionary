  m_Script: {fileID: 11500000, guid: 04a7120080da2e64b9a8c9c5ffc33ba1, type: 3}
  m_Name: Executionner
  m_EditorClassIdentifier: Assembly-CSharp::SO_DialogNPC
  _name: Executionner
  _portrait: {fileID: 21300000, guid: 2d835929965e6734583a5a572cab14c1, type: 3}
  _cards: []
  _dialogPaths:
  - entries:
    - playerText: 
      npcText: I am the executioner. $I accompany the prince in his daily affairs. 
        $Killing is an art, you know.
  - entries:
    - playerText: 
      npcText: We have many prisoners to torture today.   $I cannot speak with you
        right now.
  - entries:
    - playerText: 
      npcText: The prince is here, even on his wedding day.   $He loves this work
        even more than I do.
