  m_Script: {fileID: 11500000, guid: 377d81b95280100419232c2d7bed21d5, type: 3}
  m_Name: TheLoversCardEnding
  m_EditorClassIdentifier: Assembly-CSharp::Card
  name: The Lovers
  text: "The card glows warmly in your hand, a beacon of unity, trust, and the courage
    to follow the heart.  $Against all odds, the princess and the Head of the Royal
    Guard escape the palace walls, slipping through the chaos unnoticed.  $Hand in
    hand, they run toward the horizon, leaving behind duty, tyranny, and the rigid
    chains of the court.  $The air is filled with freedom and possibility\u2014the
    world is vast, and for the first time, their love is no longer a secret but a
    life they can truly share."
  sprite: {fileID: 21300000, guid: 20c7a64c4e5c6b60e9f9c6d587021ed6, type: 3}
