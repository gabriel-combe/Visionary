  m_Script: {fileID: 11500000, guid: 04a7120080da2e64b9a8c9c5ffc33ba1, type: 3}
  m_Name: Prince
  m_EditorClassIdentifier: Assembly-CSharp::SO_DialogNPC
  _name: Prince
  _portrait: {fileID: 21300000, guid: 26d265f1a6584354d8f4b73d0b9bb2f7, type: 3}
  _cards: []
  _dialogPaths:
  - entries:
    - playerText: 
      npcText: Who am I?  $I am your prince, you wretched hag.  $You will address
        me with respect.
  - entries:
    - playerText: 
      npcText: Back again, you disgusting old hag?  $Can you not see that I am busy
        with my work?
  - entries:
    - playerText: 
      npcText: "Out of my way.  $I must finish with this one quickly\u2014after all,
        I am to be wed this afternoon."
