  m_Script: {fileID: 11500000, guid: 04a7120080da2e64b9a8c9c5ffc33ba1, type: 3}
  m_Name: Servant
  m_EditorClassIdentifier: Assembly-CSharp::SO_DialogNPC
  _name: Servant
  _portrait: {fileID: 21300000, guid: c05b5a70842678c44b74e459333519d9, type: 3}
  _cards: []
  _dialogPaths:
  - entries:
    - playerText: 
      npcText: "Hi! Well, I must leave now.   $The wedding will begin soon, and I
        would rather not stay here any longer than I must.  $I\u2019m sorry I cannot
        tell you more.  $I hope we will see each other again soon!"
  - entries:
    - playerText: 
      npcText: "Oh, hello again! $I am not from here, but I\u2019ll tell you this:
        I do not like this place.  $The other girls say the prince is a complete
        lunatic."
  - entries:
    - playerText: 
      npcText: I come from distant lands to assist Her Majesty in the preparations
        for the royal wedding.
