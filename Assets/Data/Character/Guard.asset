MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 04a7120080da2e64b9a8c9c5ffc33ba1, type: 3}
  m_Name: Guard
  m_EditorClassIdentifier: Assembly-CSharp::SO_DialogNPC
  _name: Guard
  _portrait: {fileID: 21300000, guid: 1944f5fce0901ed4894366c53a079073, type: 3}
  _cards:
  - {fileID: 11400000, guid: bf803579fc5ca4541b4ec4a77d5f142d, type: 2}
  _dialogPaths:
  - entries:
    - playerText: 
      npcText: It's a hard life for the head of the Royal Guard. $My life stands
        beneath those of royal blood, whom I shall protect until my last breath.
    - playerText: "I won\u2019t bother you."
      npcText: Mind your own business. I have my duty.
    - playerText: Could you tell me more about yourself?
      npcText: There is nothing to tell. I only serve the kingdom.
    - playerText: "You seem troubled\u2026"
      npcText: "\u2026It is my duty to protect the princess. Nothing else matters."
    - playerText: "You seem troubled. You care for someone, don\u2019t you?"
      npcText: "\u2026Yes. I care for the Princess, but I am sworn to protect her
        above all. I cannot let feelings interfere with duty."
    - playerText: Who do you truly love, and where can I find her?
      npcText: '... Your gifts of foresight were not meerly legends then. I must
        confess, I cannot bear it anymore. I am in love with the princes but she
        and i can never be together, she is to be wedded tomorrw '
  - entries:
    - playerText: 
      npcText: ...The princess is to be married today.  $I have much work to attend
        to.
    - playerText: 
      npcText: We must flee before the afternoon.  $There is no turning back now.
  - entries:
    - playerText: 
      npcText: My duty is to protect the realm, not to indulge in gossip.
  - entries:
    - playerText: 
      npcText: I am the Head of the Royal Guard.  $My life stands beneath those of
        royal blood, whom I shall protect until my last breath.
