    onEnterOutcomes: []
    nextNodeIds: []
  - nodeId: 7f9b84668af2530bc8903e3f36ca9298
    speaker: {fileID: 11400000, guid: 1dce875a4b869a3459587f1697b290f9, type: 2}
    speakerSide: 0
    conditions: []
    npcText: <i>looks like this conversation is over</i>
    choices: []
    onEnterOutcomes: []
    nextNodeIds: []
  - nodeId: 1989ae093dadd927af609ca3cd66fdea
    speaker: {fileID: 11400000, guid: 1dce875a4b869a3459587f1697b290f9, type: 2}
    speakerSide: 0
    conditions:
    - type: 0
      param: 
      intParam: 2
    - type: 6
      param: HandOfTheKing
      intParam: 1
    - type: 7
      param: HandOfTheKing
      intParam: 2
    npcText: The wedding is tommorrow, I dont have any time to play around with your
      vision nonsense. Hurry up.
    choices:
    - playerText: The wedding is threatened by a force closer than you realize
      nextNodeIds:
      - f444aece207261d4ab25d234997d1de6
      outcomes: []
    - playerText: There are people plotting against the King.
      nextNodeIds:
      - 3de0ac4b1dddcc6637ef4b15f74fc201
      outcomes: []
    - playerText: "I can give you some guidance\u2026 perhaps a prediction."
      nextNodeIds:
      - c0e227a5f23306041a0c19902fc92e19
      outcomes: []
    - playerText: I don't have anything for you.
      nextNodeIds:
      - a3b4cd52b5a433d04c5ac8c7473ec6ca
      outcomes: []
    - playerText: "Your majesty\u2026 or should I say, oh mighty Hand, perhaps you
        could open your eyes for once?"
      nextNodeIds:
      - 316beb8e6cb5fd3066baaa90ebd74d0c
      outcomes: []
    onEnterOutcomes: []
    nextNodeIds: []
  - nodeId: f444aece207261d4ab25d234997d1de6
    speaker: {fileID: 11400000, guid: 1dce875a4b869a3459587f1697b290f9, type: 2}
    speakerSide: 0
    conditions: []
    npcText: I will inform the King. You may not be entirely useless after all.
