    nextNodeIds: []
  - nodeId: 30b5436845fc1797d2e3f31b7b7652d3
    speaker: {fileID: 11400000, guid: 1dce875a4b869a3459587f1697b290f9, type: 2}
    speakerSide: 0
    conditions: []
    npcText: I knew it. The king shall be informed.
    choices: []
    onEnterOutcomes: []
    nextNodeIds: []
  - nodeId: 39571f61f06e03d19dc6088cd37b4912
    speaker: {fileID: 11400000, guid: 1dce875a4b869a3459587f1697b290f9, type: 2}
    speakerSide: 0
    conditions: []
    npcText: That is too vague. The King demands answers.
    choices: []
    onEnterOutcomes: []
    nextNodeIds: []
  - nodeId: abdd31426f16e6f93cb793030a036228
    speaker: {fileID: 11400000, guid: 1dce875a4b869a3459587f1697b290f9, type: 2}
    speakerSide: 0
    conditions: []
    npcText: 'Of what use are you? '
    choices: []
    onEnterOutcomes: []
    nextNodeIds: []
  - nodeId: ae5f24ee29ab66f3ff71d04ec9f57e50
    speaker: {fileID: 11400000, guid: 1dce875a4b869a3459587f1697b290f9, type: 2}
    speakerSide: 0
    conditions: []
    npcText: 'Carreful there, remember who you are speaking to. '
