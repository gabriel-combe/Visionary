  - nodeId: ea41ac12639a5e97b1c689385b754bc3
    speaker: {fileID: 11400000, guid: f57a6cbc603399d4db1b2afbb697e7e3, type: 2}
    speakerSide: 0
    conditions: []
    npcText: Hah! Still nothing for you to meddle with. Step back.
