    speaker: {fileID: 11400000, guid: f57a6cbc603399d4db1b2afbb697e7e3, type: 2}
    speakerSide: 0
    conditions: []
    npcText: 'What are you ? A spy ? '
    choices: []
    onEnterOutcomes: []
    nextNodeIds: []
  - nodeId: 44687c92f91b3f13e66083113379d7f4
    speaker: {fileID: 11400000, guid: f57a6cbc603399d4db1b2afbb697e7e3, type: 2}
