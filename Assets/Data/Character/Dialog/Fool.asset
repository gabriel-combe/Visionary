    - type: 8
      param: FoolBadEnding
      intParam: 0
      card: {fileID: 0}
    npcText: 'How many merry people are here today.  '
    choices: []
    onEnterOutcomes: []
    nextNodeIds:
    - 569a2fef27062312d2337df2150cb20b
  - nodeId: e545706b0683547112ff4d63f06a8933
    speaker: {fileID: 11400000, guid: f57a6cbc603399d4db1b2afbb697e7e3, type: 2}
