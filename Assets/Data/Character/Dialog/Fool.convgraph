      data:
        m_Value:
        - playerText: What are you scheming?
          outcomes: []
        - playerText: 'You look like you have plans '
          outcomes: []
        - playerText: "You seem angry\u2026 plotting something?"
          outcomes: []
        - playerText: "The people suffer\u2026 are you plotting to help them?"
          outcomes:
          - type: 0
            param: 
            card: {fileID: 11400000, guid: fc214faf4ac6b0a4b97e870477a16e3b, type: 2}
        - playerText: "Tell me everything\u2014I want to help the people and see
            justice done."
          outcomes:
          - type: 0
            param: 
            card: {fileID: 11400000, guid: fc214faf4ac6b0a4b97e870477a16e3b, type: 2}
