      data:
        m_Value:
        - playerText: I'll leave
          outcomes: []
        - playerText: Could you tell me more ?
          outcomes: []
        - playerText: 'You look unhappy. '
          outcomes: []
        - playerText: You look unhappy, Princess. I have the gift of foresight and
            could help you if you let me.
          outcomes: []
        - playerText: "Perhaps fate is not as fixed as it seems\u2026 you may yet
            follow your heart, if you are brave enough."
          outcomes: []
